 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a>Version 0.2.2</h2>\n<ul>\n<li>load: custom user module loader</li>\n</ul>\n<h2 id=\"version-021\" style=\"position:relative;\"><a href=\"#version-021\" aria-label=\"version 021 permalink\" class=\"anchor before\"><svg aria-hidden=\"true\" height=\"20\" version=\"1.1\" viewBox=\"0 0 16 16\" width=\"20\"><path fill-rule=\"evenodd\" fill=\"#fff\" d=\"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a>Version 0.2.1</h2>\n<ul>\n<li>commands: default to help fixed on presence of options</li>\n<li>run: error handling for humans</li>\n</ul>\n<h2 id=\"version-020\" style=\"position:relative;\"><a href=\"#version-020\" aria-label=\"version 020 permalink\" class=\"anchor before\"><svg aria-hidden=\"true\" height=\"20\" version=\"1.1\" viewBox=\"0 0 16 16\" width=\"20\"><path fill-rule=\"evenodd\" fill=\"#fff\" d=\"M4 9h1v1H4c-1.5 0-3-1.69-3-3.5S2.55 3 4 3h4c1.45 0 3 1.69 3 3.5 0 1.41-.91 2.72-2 3.25V8.59c.58-.45 1-1.27 1-2.09C10 5.22 8.98 4 8 4H4c-.98 0-2 1.22-2 2.5S3 9 4 9zm9-3h-1v1h1c1 0 2 1.22 2 2.5S13.98 12 13 12H9c-.98 0-2-1.22-2-2.5 0-.83.42-1.64 1-2.09V6.25c-1.09.53-2 1.84-2 3.25C6 11.31 7.55 13 9 13h4c1.45 0 3-1.69 3-3.5S14.5 6 13 6z\"></path></svg></a>Version 0.2.0</h2>\n<ul>\n<li>package: release commands</li>\n<li>package: update Node.js version inside Travis</li>\n<li>parse: better error handling</li>\n<li>options: new default option</li>\n<li>test: should required by mocha</li>\n<li>help: fix shortcut in commands</li>\n<li>options: run get context, argv and config</li>\n<li>options: run options accepts a function or a module</li>\n<li>readme: API documentation</li>\n<li>package: upgrade to CoffeeScript 2</li>\n</ul>","frontmatter":{"title":"Changelog","keywords":["shell","node.js","changelog","history","feature","changes","version"],"description":"Complete changelog of the Shell.js package"},"fields":{"edit_url":"https://github.com/adaltas/node-shell/edit/master/docs/content/project/changelog.md","slug":"/project/changelog/"},"headings":[{"value":"0.12.0 (2024-11-24)","depth":2,"id":"0120-2024-11-24"},{"value":"Features","depth":3,"id":"features"},{"value":"0.11.0 (2024-08-04)","depth":2,"id":"0110-2024-08-04"},{"value":"0.10.1 (2024-07-27)","depth":2,"id":"0101-2024-07-27"},{"value":"0.10.0 (2024-07-27)","depth":1,"id":"0100-2024-07-27"},{"value":"Features","depth":3,"id":"features-1"},{"value":"0.9.5 (2024-01-17)","depth":2,"id":"095-2024-01-17"},{"value":"Bug Fixes","depth":3,"id":"bug-fixes"},{"value":"0.9.4 (2022-03-15)","depth":2,"id":"094-2022-03-15"},{"value":"Bug Fixes","depth":3,"id":"bug-fixes-1"},{"value":"0.9.3 (2022-03-15)","depth":2,"id":"093-2022-03-15"},{"value":"Bug Fixes","depth":3,"id":"bug-fixes-2"},{"value":"0.9.2 (2022-02-24)","depth":2,"id":"092-2022-02-24"},{"value":"Bug Fixes","depth":3,"id":"bug-fixes-3"},{"value":"0.9.1 (2022-02-17)","depth":2,"id":"091-2022-02-17"},{"value":"Bug Fixes","depth":3,"id":"bug-fixes-4"},{"value":"0.9.0 (2022-02-16)","depth":1,"id":"090-2022-02-16"},{"value":"Features","depth":3,"id":"features-2"},{"value":"0.8.6 (2022-01-06)","depth":2,"id":"086-2022-01-06"},{"value":"Bug Fixes","depth":3,"id":"bug-fixes-5"},{"value":"0.8.5 (2021-12-02)","depth":2,"id":"085-2021-12-02"},{"value":"Bug Fixes","depth":3,"id":"bug-fixes-6"},{"value":"0.8.4 (2020-12-09)","depth":2,"id":"084-2020-12-09"},{"value":"0.8.3 (2020-12-07)","depth":2,"id":"083-2020-12-07"},{"value":"0.8.2 (2020-12-07)","depth":2,"id":"082-2020-12-07"},{"value":"Features","depth":3,"id":"features-3"},{"value":"0.8.1 (2020-11-24